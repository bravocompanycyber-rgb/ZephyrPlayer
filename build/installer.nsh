; ZephyrPlayer: generated by editions/apply-edition.js
; Windows replaces an existing install in place; this tells the user it is an UPDATE (silent installs just continue).
!macro customInit
  StrCpy $R9 "0"
  IfFileExists "$LOCALAPPDATA\Programs\ZephyrPlayer\ZephyrPlayer.exe" 0 +2
    StrCpy $R9 "1"
  IfFileExists "$PROGRAMFILES64\ZephyrPlayer\ZephyrPlayer.exe" 0 +2
    StrCpy $R9 "1"
  IfFileExists "$PROGRAMFILES\ZephyrPlayer\ZephyrPlayer.exe" 0 +2
    StrCpy $R9 "1"
  StrCmp $R9 "1" 0 +3
    MessageBox MB_YESNO|MB_ICONQUESTION "ZephyrPlayer is already installed on this PC.$\r$\n$\r$\nThis installer will UPDATE it. Your settings, playlist and downloaded tools are kept.$\r$\n$\r$\nContinue?" /SD IDYES IDYES +2
    Abort
!macroend
